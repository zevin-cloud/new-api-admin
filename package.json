{
  "name": "new-api-admin",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run build:ui && bun run --cwd apps/admin dev",
    "build": "bun run --cwd packages/admin-ui build && bun run --cwd apps/admin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint packages/admin-ui/src apps/admin/src scripts",
    "format": "oxfmt --write packages/admin-ui/src apps/admin/src scripts",
    "format:check": "oxfmt --check packages/admin-ui/src apps/admin/src scripts",
    "i18n:sync": "bun scripts/sync-i18n.mjs",
    "pack:ui": "bun run --cwd packages/admin-ui build && cd packages/admin-ui && bun pm pack --destination ../../artifacts",
    "build:ui": "bun run --cwd packages/admin-ui build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.4",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/jest-dom": "^7.0.0",
    "vitest": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.72.0",
    "oxfmt": "^0.57.0",
    "shadcn": "^4.12.0",
    "tailwindcss": "^4.3.2",
    "@fontsource-variable/lora": "^5.2.8",
    "@fontsource-variable/public-sans": "^5.2.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "@tailwindcss/cli": "^4.3.2",
    "@playwright/test": "^1.58.2"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^17.0.8",
    "@tanstack/react-table": "^8.21.3",
    "i18next": "^26.3.4"
  }
}
