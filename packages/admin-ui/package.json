{
  "name": "new-api-admin-ui",
  "version": "0.2.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "files": [
    "dist",
    "src/styles/theme.css",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data-table": {
      "types": "./dist/components/data-table/index.d.ts",
      "import": "./dist/components/data-table/index.js"
    },
    "./form": {
      "types": "./dist/components/ui/form.d.ts",
      "import": "./dist/components/ui/form.js"
    },
    "./layout": {
      "types": "./dist/admin-layout.d.ts",
      "import": "./dist/admin-layout.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/styles/theme.css",
    "./ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun ../../scripts/build-css.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.21",
    "dompurify": "3.4.13",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "katex": "^0.17.0",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.5",
    "motion": "^12.42.2",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.0",
    "recharts": "3.9.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "yace": "^1.1.0"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^17.0.8",
    "@tanstack/react-table": "^8.21.3",
    "i18next": "^26.3.4"
  }
}
